    pretty(hoblis)

else:

    print(
        "\nHobli lookup using names failed."
    )

    print(
        "Use the district/taluk codes printed above "
        "to make the next request."
    )


# ---------------------------------------------------------
# 4. DSS DISTRICT
# ---------------------------------------------------------

print("\n==============================================")
print("4. DSS DISTRICT")
print("==============================================")

dss_districts = api_get(
    "GetdssDistrict",
    {
        "culture": CULTURE
    }
)

if dss_districts is not None:

    save_json(
        "04_dss_districts.json",
