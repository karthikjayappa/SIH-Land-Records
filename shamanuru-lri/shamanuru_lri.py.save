import requests
import json
import sys
from urllib.parse import urlencode

BASE_URL = "https://mobservice.sujala3lri.karnataka.gov.in/api"

# ---------------------------------------------------------
# SETTINGS
# ---------------------------------------------------------

CULTURE = 1

TARGET_DISTRICT = "Davangere"
TARGET_TALUK = "Davangere"
TARGET_VILLAGE = "Shamanuru"

# Try both common spellings/cases
VILLAGE_NAMES = [
    "Shamanuru",
    "Shamanur",
    "SHAMANURU",
    "SHAMANUR"
]

TIMEOUT = 30


# ---------------------------------------------------------
# BASIC HTTP FUNCTION
# ---------------------------------------------------------

def api_get(endpoint, params=None):
    url = f"{BASE_URL}/{endpoint}"

    print("\n--------------------------------------------------")
    print("GET:", url)

    if params:
        print("PARAMS:", params)

    try:
        response = requests.get(
            url,
            params=params,
            timeout=TIMEOUT,
            headers={
                "Accept": "application/json",
                "User-Agent": "Mozilla/5.0"
            }
        )

        print("STATUS:", response.status_code)
        print("FINAL URL:", response.url)

        response.raise_for_status()

        if not response.text.strip():
            print("EMPTY RESPONSE")
            return None

        try:
            return response.json()

        except ValueError:
            print("Response was not JSON.")
            print(response.text[:2000])
            return response.text

    except requests.exceptions.RequestException as e:
        print("REQUEST ERROR:", e)
        return None


# ---------------------------------------------------------
# PRINT JSON
# ---------------------------------------------------------

def pretty(data):
    print(
        json.dumps(
            data,
            indent=2,
            ensure_ascii=False
        )
    )


# ---------------------------------------------------------
# SAVE JSON
# ---------------------------------------------------------

def save_json(filename, data):

    with open(filename, "w", encoding="utf-8") as f:

        json.dump(
            data,
            f,
            indent=2,
            ensure_ascii=False
        )

    print(f"\nSaved: {filename}")


# ---------------------------------------------------------
# FIND OBJECT VALUE
# ---------------------------------------------------------

def get_value(obj, possible_names):

    if not isinstance(obj, dict):
        return None

    for name in possible_names:

        if name in obj:
            return obj[name]

    # case-insensitive search
    lower_map = {
        str(k).lower(): v
        for k, v in obj.items()
    }

    for name in possible_names:

        if name.lower() in lower_map:
            return lower_map[name.lower()]

    return None


# ---------------------------------------------------------
# SEARCH RECURSIVELY
# ---------------------------------------------------------

def find_matching_objects(data, search_names):

    results = []

    if isinstance(data, list):

        for item in data:
            results.extend(
                find_matching_objects(
                    item,
                    search_names
                )
            )

    elif isinstance(data, dict):

        # Look at likely name fields
        name_fields = [
            "name",
            "district_name",
            "District_Name",
            "taluk_name",
            "Taluk_Name",
            "village_name",
            "Village_Name",
            "hobli_name",
            "Hobli_Name",
            "text",
            "Name"
        ]

        for field in name_fields:

            value = data.get(field)

            if value is not None:

                value_string = str(value).strip().lower()

                for target in search_names:

                    if value_string == target.strip().lower():

                        results.append(data)
                        break

        # Continue recursively
        for value in data.values():

            if isinstance(value, (dict, list)):

                results.extend(
                    find_matching_objects(
                        value,
                        search_names
                    )
                )

    return results


# ---------------------------------------------------------
# 1. GET DISTRICTS
# ---------------------------------------------------------

print("\n==============================================")
print("1. GET DISTRICTS")
print("==============================================")

districts = api_get(
    "GetDistrict",
    {
        "culture": CULTURE
    }
)

if districts is None:
    print("Could not retrieve districts.")
    sys.exit()

save_json(
    "01_districts.json",
    districts
)

matches = find_matching_objects(
    districts,
    [TARGET_DISTRICT]
)

print("\nDavangere matches:")

for item in matches:
    pretty(item)


# ---------------------------------------------------------
# 2. GET TALUK
# ---------------------------------------------------------

print("\n==============================================")
print("2. GET TALUKS")
print("==============================================")

# First attempt:
# API documentation specifies:
#
# GetTaluk?district={district}&culture={culture}

taluks = api_get(
    "GetTaluk",
    {
        "district": TARGET_DISTRICT,
        "culture": CULTURE
    }
)

if taluks is not None:

    save_json(
        "02_taluks.json",
        taluks
    )

    print("\nDavangere Taluk matches:")

    taluk_matches = find_matching_objects(
        taluks,
        [TARGET_TALUK]
    )

    for item in taluk_matches:
        pretty(item)

else:

    print(
        "\nGetTaluk did not return usable data."
    )

    print(
        "The API may require the district CODE rather "
        "than the district name."
    )


# ---------------------------------------------------------
