# ---------------------------------------------------------
# 6. SAVE SUMMARY
# ---------------------------------------------------------

summary = {
    "target": {
        "district": TARGET_DISTRICT,
        "taluk": TARGET_TALUK,
        "village": TARGET_VILLAGE
    },

    "api": BASE_URL,

    "next_step": [
        "Resolve District ID",
        "Resolve Taluk ID",
        "Resolve Hobli ID",
        "Resolve Village ID",
        "Retrieve survey numbers",
        "Retrieve cadastral geometry",
        "Retrieve Bhoomi data"
    ]
}

save_json(
